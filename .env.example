# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
OFFBOOK_SECRET_KEY=
# 1 behind HTTPS (compose sets this), 0 for local http
OFFBOOK_SECURE_COOKIES=0

# Reads photographed script pages (needs a model that accepts images)
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
PARSE_MODEL=anthropic/claude-haiku-5.5
# Hard stop on AI calls per day (one call per script page)
LLM_DAILY_CAP=200

# Days to keep recordings of the children's own lines (only made when they tick the box)
ATTEMPT_RETENTION_DAYS=7

# Kokoro-FastAPI. Locally http://localhost:8880; compose overrides this with the container name.
KOKORO_URL=http://localhost:8880
